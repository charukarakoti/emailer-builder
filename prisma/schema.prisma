// =============================================================================
// emailer-builder — Prisma schema
// =============================================================================
// The schema covers every table required for a Mailchimp-style SaaS:
//
//   • Identity   — User, Session, Membership, Invite
//   • Workspace  — Team (= "workspace" in product copy)
//   • Templates  — Template, TemplateVersion
//   • CRM        — Contact, List, ContactList, Tag, ContactTag
//   • Campaigns  — Campaign, CampaignRecipient
//   • Tracking   — EmailEvent
//   • Forms      — Form, FormSubmission
//   • Media      — Media
//   • Audit      — ActivityLog
//
// Design notes:
//
//   - Provider is SQLite for dev (zero-setup). Swap to "postgresql" in
//     production — no schema changes are needed; the JSON-as-String columns
//     work on both.
//   - Enum-like fields are stored as String with documented allowed values,
//     because SQLite doesn't support Prisma enums.
//   - JSON payloads are stored as String and JSON.stringify/parse'd at the
//     route handler boundary. On Postgres these can be promoted to `Json`.
//   - Every workspace-bound model carries `teamId` and is indexed on it so
//     the workspace-scoped query path is fast at any size.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  createdAt    DateTime     @default(now())

  memberships  Membership[]
  templates    Template[]
  sessions     Session[]
  invitesSent  Invite[]              @relation("InvitesSent")
  uploads      Media[]
  activity     ActivityLog[]
  templateEdits TemplateVersion[]    @relation("TemplateVersionAuthor")
  campaignsCreated Campaign[]        @relation("CampaignsCreated")
}

model Team {
  id          String       @id @default(cuid())
  name        String
  // URL-friendly identifier — used in invite + form embed links. Optional
  // so existing rows keep working; new workspaces should set it.
  slug        String?      @unique
  createdAt   DateTime     @default(now())

  memberships Membership[]
  templates   Template[]
  invites     Invite[]
  sessions    Session[]
  contacts    Contact[]
  lists       List[]
  tags        Tag[]
  campaigns   Campaign[]
  forms       Form[]
  media       Media[]
  activity    ActivityLog[]
  events      EmailEvent[]
  companies   Company[]
  designations Designation[]
  cvs         Cv[]
  signatures  Signature[]
}

// SQLite doesn't support Prisma enums, so role is a free string with a
// default. App code only ever writes "OWNER" or "MEMBER".
model Membership {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

model Invite {
  id        String   @id @default(cuid())
  code      String   @unique
  teamId    String
  email     String?
  invitedBy String
  createdAt DateTime @default(now())
  expiresAt DateTime
  redeemedAt DateTime?
  redeemedBy String?

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter   User     @relation("InvitesSent", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  activeTeamId String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTeam   Team?    @relation(fields: [activeTeamId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Templates
// ---------------------------------------------------------------------------

model Template {
  id          String   @id @default(cuid())
  name        String
  // EmailDocument JSON serialized as a string. (SQLite has no Json type.)
  doc         String
  // "private" — only this workspace can read. "public" — read-only on the
  // public discovery page (Phase 1+). Defaults to "private".
  visibility  String   @default("private")
  // Cached HTML render — populated on save so list views can show thumbnails
  // without re-rendering. Optional.
  thumbnailHtml String?
  ownerId     String
  teamId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  team        Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  versions    TemplateVersion[]
  campaigns   Campaign[]

  @@index([teamId, createdAt])
  @@index([ownerId])
  @@index([visibility])
}

// Append-only snapshots. Created on every save once Phase 1 wires it up.
// "label" is optional human-readable description ("autosave", "manual",
// or a custom note).
model TemplateVersion {
  id         String   @id @default(cuid())
  templateId String
  doc        String
  label      String?
  authorId   String?
  createdAt  DateTime @default(now())

  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  author     User?    @relation("TemplateVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([templateId, createdAt])
}

// ---------------------------------------------------------------------------
// CRM — contacts, lists, tags
// ---------------------------------------------------------------------------

model Contact {
  id         String   @id @default(cuid())
  teamId     String
  // Unique within a workspace.
  email      String
  firstName  String?
  lastName   String?
  // Free-form key/value attributes for custom fields. JSON-as-string.
  attributes String?
  // "subscribed" | "unsubscribed" | "bounced" | "complained" | "pending"
  status     String   @default("subscribed")
  source     String?  // "import" | "form" | "api" | "manual"
  // Optional links to the CRM tables added in the SaaS upgrade.
  companyId      String?
  designationId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  team        Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company     Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  designation Designation?       @relation(fields: [designationId], references: [id], onDelete: SetNull)
  lists       ContactList[]
  tags        ContactTag[]
  recipients  CampaignRecipient[]
  events      EmailEvent[]
  submissions FormSubmission[]
  cvs         Cv[]

  @@unique([teamId, email])
  @@index([teamId, status])
  @@index([companyId])
  @@index([designationId])
}

model List {
  id          String   @id @default(cuid())
  teamId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contacts ContactList[]
  forms    Form[]

  @@index([teamId])
}

model ContactList {
  id        String   @id @default(cuid())
  contactId String
  listId    String
  addedAt   DateTime @default(now())

  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([contactId, listId])
  @@index([listId])
}

model Tag {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  color     String?
  createdAt DateTime @default(now())

  team     Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contacts ContactTag[]

  @@unique([teamId, name])
}

model ContactTag {
  id        String   @id @default(cuid())
  contactId String
  tagId     String
  addedAt   DateTime @default(now())

  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Campaigns — sending
// ---------------------------------------------------------------------------

model Campaign {
  id          String   @id @default(cuid())
  teamId      String
  name        String
  subject     String
  fromName    String?
  fromEmail   String?
  replyTo     String?
  templateId  String?
  // "draft" | "scheduled" | "sending" | "sent" | "failed" | "canceled"
  status      String   @default("draft")
  // ISO timestamp for scheduled send. Null when sending immediately.
  scheduledAt DateTime?
  sentAt      DateTime?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  template    Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy   User                @relation("CampaignsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  recipients  CampaignRecipient[]
  events      EmailEvent[]

  @@index([teamId, status])
  @@index([scheduledAt])
}

model CampaignRecipient {
  id          String    @id @default(cuid())
  campaignId  String
  contactId   String
  // "pending" | "sent" | "delivered" | "opened" | "clicked" | "bounced" |
  // "unsubscribed" | "complained" | "failed"
  status      String    @default("pending")
  sentAt      DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  errorMsg    String?

  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
}

// Append-only per-event log. One row per open / click / etc.
model EmailEvent {
  id         String   @id @default(cuid())
  teamId     String
  campaignId String?
  contactId  String?
  // "delivered" | "open" | "click" | "bounce" | "complaint" | "unsubscribe"
  type       String
  // For "click": destination URL. For "bounce": error reason.
  meta       String?
  // Where the event came from (provider webhook id, tracking pixel, etc.)
  source     String?
  createdAt  DateTime @default(now())

  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([teamId, type, createdAt])
  @@index([campaignId])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Forms
// ---------------------------------------------------------------------------

model Form {
  id          String   @id @default(cuid())
  teamId      String
  name        String
  // "embed" | "popup" | "inline"
  type        String   @default("embed")
  // JSON-as-string: fields[], theme, success message, redirect URL, etc.
  config      String
  // Optional default list to add submissions to.
  listId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  list        List?            @relation(fields: [listId], references: [id], onDelete: SetNull)
  submissions FormSubmission[]

  @@index([teamId])
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  // The fully-resolved Contact if we matched/created one.
  contactId String?
  // JSON-as-string of the raw submission payload.
  payload   String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([formId, createdAt])
}

// ---------------------------------------------------------------------------
// Media library
// ---------------------------------------------------------------------------

model Media {
  id          String   @id @default(cuid())
  teamId      String
  // "image" | "file"
  kind        String   @default("image")
  // Public URL — for S3 this is the bucket URL, for local storage it's
  // `/uploads/<filename>`.
  url         String
  // Storage key for delete operations (e.g. the S3 object key).
  storageKey  String?
  filename    String
  contentType String?
  sizeBytes   Int?
  width       Int?
  height      Int?
  uploadedById String?
  createdAt   DateTime @default(now())

  team        Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  uploadedBy  User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// SaaS CRM extensions — Company, Designation, Cv
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  industry  String?
  website   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contacts Contact[]

  @@unique([teamId, name])
  @@index([teamId])
}

model Designation {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  // "engineering" | "sales" | "marketing" | "executive" | "operations" | "other"
  category  String?
  createdAt DateTime @default(now())

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contacts Contact[]

  @@unique([teamId, name])
  @@index([teamId])
}

model Cv {
  id          String   @id @default(cuid())
  teamId      String
  // Optional Contact this CV belongs to.
  contactId   String?
  // Display name shown in the library.
  title       String
  // Public URL of the uploaded file (signed S3 URL, /uploads path, etc.)
  url         String
  storageKey  String?
  filename    String
  contentType String?  // application/pdf | application/msword | ...
  sizeBytes   Int?
  uploadedById String?
  createdAt   DateTime @default(now())

  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([contactId])
}

/// Email signature designed in the Signature builder. `doc` is the JSON
/// SignatureDoc (theme + ordered list of blocks). Rendering lives in
/// lib/signatureHtml.ts and emits Outlook-compatible table HTML.
model Signature {
  id        String   @id @default(cuid())
  teamId    String
  ownerId   String
  name      String
  doc       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, updatedAt])
  @@index([ownerId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  teamId    String
  userId    String?
  // "template.created" | "template.updated" | "campaign.sent" | etc.
  action    String
  // Free-form target reference, e.g. "template:abc123".
  target    String?
  // JSON-as-string for any extra context.
  meta      String?
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([userId])
}
