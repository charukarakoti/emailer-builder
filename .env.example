# =============================================================================
# emailer-builder — environment variables
#
# Copy this file to `.env` and fill in real values.
# =============================================================================

# Postgres connection string. Local example:
#   postgresql://postgres:postgres@localhost:5432/emailer_builder?schema=public
# Hosted example (Neon):
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emailer_builder?schema=public"

# SMTP (outbound email). All five are required for /api/send.
# Gmail App Password setup: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="Your Name <you@gmail.com>"
